GEMINI_API_KEY = "your-gemini-api-key-here"

# Base del portal humano; SynapseMD abre exactamente `${URL}/authorize`.
SARA_AUTH_PORTAL_URL = "http://localhost:3000"
# API central usada sólo por Streamlit para token, refresh, introspección y logout.
SARA_IDENTITY_URL = "http://127.0.0.1:8001"
# Debe coincidir byte por byte con el redirect registrado para `synapse-web`.
SARA_AUTH_CALLBACK_URL = "http://localhost:8502/"

# Clave Fernet distinta por despliegue. Genérala como se indica en README y no
# la reutilices como ningún otro secreto de la aplicación.
SARA_AUTH_TRANSACTION_KEY = "replace-with-a-generated-fernet-key"
# SQLite WAL es apropiado sólo cuando todas las instancias comparten un host.
SARA_AUTH_TRANSACTION_DB = ".data/sara_auth_transactions.sqlite3"
SARA_AUTH_TRANSACTION_TTL_SECONDS = 300
SARA_AUTH_TRANSACTION_MAX_PENDING = 1000

# Opcional. El archivo real no debe versionarse. Sin entrada explícita para un UUID,
# el namespace nuevo es el UUID central y nunca el email o nombre.
SARA_LEGACY_NAMESPACE_MANIFEST = "legacy_namespaces.json"
